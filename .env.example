# Server-side only. Never prefix these with VITE_ — that would inline them into
# the browser bundle and expose them on a public page.

# Pardot (Account Engagement) Form Handler.
# The URL is the credential: anyone holding it can inject prospects, so it is
# kept here rather than in the page.
#
# LOCALLY, point this at `pnpm stub` (http://localhost:9911/...). The live URL
# writes to the client's CRM — every dev submission becomes a real Prospect.
# It belongs only in the production server's .env.
PARDOT_FORM_HANDLER_URL=

# The handler's OWN configured Success / Error Locations — copy them from the
# Form Handler setup, or leave both blank. A wrong value is worse than none:
# delivery is then judged against a URL Pardot never redirects to.
#
# Leave blank when testing against the live handler unless you have the real
# values. The 1119553 handler currently answers 200 inline and does not redirect
# at all, so these have no effect on it.
PARDOT_SUCCESS_URL=
PARDOT_ERROR_URL=


# CAPTCHA is opt-in and needs BOTH variables. With either one blank the check is
# skipped entirely, which is the default: leave them empty until the client-side
# widget is wired, or every real lead is refused for want of a token.
# Verify URLs: Turnstile  https://challenges.cloudflare.com/turnstile/v0/siteverify
#              reCAPTCHA  https://www.google.com/recaptcha/api/siteverify
#              hCaptcha   https://api.hcaptcha.com/siteverify
CAPTCHA_SECRET=
CAPTCHA_VERIFY_URL=

PORT=8787
